# ETL Environment Configuration
# Copy this file to .env and fill in actual values

# =====================================================
# DATABASE CONFIGURATION
# =====================================================

# Operational Database (Source)
DB_OPERATIONAL_HOST=localhost
DB_OPERATIONAL_PORT=5432
DB_OPERATIONAL_NAME=enterprise_ai_platform
DB_OPERATIONAL_USER=postgres
DB_OPERATIONAL_PASSWORD=your_password_here

# Analytics Schema
DB_ANALYTICS_SCHEMA=analytics

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =====================================================
# LOGGING CONFIGURATION
# =====================================================

LOG_LEVEL=INFO
LOG_DIR=./etl/logs

# =====================================================
# PIPELINE CONFIGURATION
# =====================================================

# Batch size for processing
ETL_BATCH_SIZE=1000

# Number of retries on failure
ETL_MAX_RETRIES=3

# Retry delay in seconds
ETL_RETRY_DELAY=5

# Data validation
ETL_VALIDATE_DATA=True

# Incremental loading (future feature)
ETL_INCREMENTAL_LOAD=False

# Drop existing tables (for dev/test)
ETL_RECREATE_TABLES=False

# =====================================================
# DATA QUALITY CONFIGURATION
# =====================================================

# Maximum allowed null percentage per column
DQ_NULL_THRESHOLD=0.1

# Duplicate row percentage threshold
DQ_DUPLICATE_THRESHOLD=0.01

# Enable data profiling
DQ_ENABLE_PROFILING=False
